# ===========================================================================
# Prosengit CMS — Environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ===========================================================================

# --- Server ---
# Port the backend (website + admin + API) runs on.
PORT=3000
# Base URL of the site (no trailing slash). Used for canonical URLs, OG tags,
# sitemap and absolute asset URLs in the admin panel.
SITE_URL=https://prosengitkundu.top
# Public URL prefix where media uploads are served.
PUBLIC_BASE_URL=https://prosengitkundu.top

# --- Session / security ---
# Random, long, high-entropy secret. Generate e.g. with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-hex-string
# Enables the app to trust the reverse proxy (set to true behind Nginx/Heroku/Railway).
TRUST_PROXY=false

# --- Database ---
# File path (relative to backend/) for the SQLite database.
DB_PATH=./data/cms.db

# --- Admin bootstrap ---
# The first admin account is created from these values on `npm run create-admin`
# (or automatically on first seed if it does not yet exist).
ADMIN_USERNAME=admin
# Strong password. Change after first login.
ADMIN_PASSWORD=ChangeMe123!
# Public display name for the admin user.
ADMIN_NAME=Site Administrator

# --- Media uploads ---
# Max upload size in megabytes.
MAX_UPLOAD_MB=12

# --- Security / CORS ---
# Comma-separated list of allowed origins for the API (browsers only send an
# Origin header cross-site; same-site requests don't need it). Leave * for same-origin.
CORS_ORIGIN=*

# --- Email notifications (optional; leave blank to disable) ---
# If provided, contact-form submissions send an email notification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
